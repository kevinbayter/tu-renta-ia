# Copia este archivo como .env.local y completa los valores.
# .env.local nunca se sube al repositorio.

# ── Base de datos y sesión (requeridas) ────────────────────────────────────
# La del Postgres de `docker compose up -d` (docker-compose.yml)
DATABASE_URL=postgresql://turenta:turenta_dev@localhost:5433/turenta_dev
# Cadena aleatoria de 32 caracteres o más: openssl rand -base64 48
AUTH_SECRET=

# ── Proveedor de IA (compatible con OpenAI) ────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_FORMATO_JSON=json_object

# ── Correo (OTP y recordatorios de vencimiento) ────────────────────────────
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NOMBRE=TuRenta

# ── Conexión con la DIAN ───────────────────────────────────────────────────
# Sin WORKER_DIAN_URL y WORKER_DIAN_TOKEN el botón "Presentar ante la DIAN"
# no aparece: la app funciona igual, con la guía para presentar a mano.
# `pnpm dev` arranca la web y el worker juntos.
WORKER_DIAN_URL=http://localhost:8787
# El mismo valor para la web y el worker: openssl rand -hex 32
WORKER_DIAN_TOKEN=
# Puerto del worker en local. No lo pongas en .env.dian.local (Docker usa 8080).
WORKER_DIAN_PUERTO=8787
# Cifra la contraseña guardada con "recordar mi acceso". 64 caracteres
# hexadecimales: openssl rand -hex 32. Si la cambias, los accesos guardados
# dejan de abrirse y la app vuelve a pedir la contraseña.
DIAN_CRED_KEY=
