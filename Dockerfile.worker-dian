# TuRenta AI - DIAN connection worker (Playwright + Chromium).
#
# Runs ISOLATED: no DATABASE_URL and none of the application secrets. It is the
# only process that runs a browser and sees user credentials, so a compromise
# here does not drag the platform down (PLAN-DIAN §2 and §4).
#
# The official image ships the exact Chromium the library expects plus every
# system dependency. The tag must match the playwright version in the lockfile
# (1.61.1): bump one, bump the other, or startup fails with
# "Executable doesn't exist".
#
# Alpine is not an option: Playwright does not support it officially and apk's
# chromium is a different build. The adapter is calibrated against Playwright's
# Chromium and MUISCA depends on fine details (real pointer hover on the menu,
# clicks on input[type=image], a 0x0 px download link).

FROM mcr.microsoft.com/playwright:v1.61.1-noble AS base
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN corepack enable
WORKDIR /app

# ---------- Dependencies ----------
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/worker-dian/package.json apps/worker-dian/
COPY packages/core/package.json packages/core/
COPY packages/motor-fiscal/package.json packages/motor-fiscal/
COPY packages/shared/package.json packages/shared/
COPY packages/adaptadores/package.json packages/adaptadores/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# ---------- Build: a single bundle, playwright kept external ----------
FROM deps AS build
COPY packages ./packages
COPY apps/worker-dian ./apps/worker-dian
RUN pnpm --filter @turenta/worker-dian bundle

# ---------- Runtime ----------
FROM base AS runner
ENV NODE_ENV=production PORT=8080
# Playwright only: no Prisma, no pg, no mail client. The bundle already carries
# the domain and the adapter inside.
COPY --from=deps --chown=pwuser:pwuser /app/node_modules/playwright ./node_modules/playwright
COPY --from=deps --chown=pwuser:pwuser /app/node_modules/playwright-core ./node_modules/playwright-core
COPY --from=build --chown=pwuser:pwuser /app/apps/worker-dian/dist ./dist

# pwuser ships with the official image: Chromium never runs as root.
USER pwuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/salud').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/servidor.mjs"]
