{
  "name": "@turenta/adaptadores",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dian": "./src/dian/conexion-muisca.ts",
    "./test/navegador/servidor-fixtures": "./test/navegador/servidor-fixtures.ts",
    "./test/navegador/fixtures/datos-ficticios": "./test/navegador/fixtures/datos-ficticios.ts",
    "./cifrado": "./src/dian/cifrado-credenciales.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test:navegador": "vitest run --config vitest.navegador.config.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@turenta/core": "workspace:*",
    "@turenta/shared": "workspace:*",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "playwright": "^1.61.1",
    "unpdf": "^1.3.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@turenta/motor-fiscal": "workspace:*",
    "@types/node": "^22.17.0",
