generator client {
  provider = "prisma-client"
  output   = "../src/persistencia/generado"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id             String         @id @default(uuid())
  email          String         @unique
  nombres        String         @default("")
  apellidos      String         @default("")
  identificacion String         @default("")
  /// Preferencias de UI y notificaciones (widgets del panel, emails de vencimiento)
  preferencias   Json           @default("{}")
  fotoAvatar     Bytes?
  creadoEn       DateTime       @default(now())
  declaraciones  Declaracion[]
  codigosOtp     CodigoOtp[]
  personas       Persona[]
  actividades    Actividad[]
  notificaciones Notificacion[]
  autorizacionesDian AutorizacionDian[]
  credencialesDian   CredencialDian[]
}

/// Acceso a la DIAN guardado a petición expresa del usuario.
/// SOLO contiene el sobre cifrado (AES-256-GCM): la clave vive en el worker
/// aislado, que no tiene acceso a esta base. Robar la base no basta.
model CredencialDian {
  id                    String    @id @default(uuid())
  usuarioId             String
  usuario               Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titularIdentificacion String
  tipoDocumento         String
  numeroDocumento       String
  /// Sobre cifrado. Sin la clave del worker es ruido.
  cifradoVersion        Int
  cifradoNonce          String
  cifradoTag            String
  cifradoContenido      String
  creadoEn              DateTime  @default(now())
  ultimoUsoEn           DateTime?

  @@unique([usuarioId, titularIdentificacion])
  @@index([ultimoUsoEn])
}

/// Evidencia de que el titular autorizó una conexión con la DIAN (PLAN-DIAN §1.3).
/// Solo se anexa: se escribe al aceptar y se cierra con el desenlace real.
/// NUNCA contiene la contraseña de la DIAN ni nada derivado de ella.
model AutorizacionDian {
  id                    String    @id @default(uuid())
  /// Quién operó (hoy = titular; futuro B2B = contador). Null si borró su cuenta:
  /// la evidencia sobrevive disociada en vez de destruirse.
  operadorUsuarioId     String?
  operador              Usuario?  @relation(fields: [operadorUsuarioId], references: [id], onDelete: SetNull)
  /// Cédula del titular cuya cuenta DIAN se consulta.
  titularIdentificacion String
  /// Exactamente los alcances que enumeró la autorización aceptada.
  alcances              String[]
  /// Versión del texto legal y SHA-256 de lo que el usuario vio en pantalla.
  /// Se guarda el hash, no el texto: prueba integridad sin duplicar el contenido.
  versionTexto          String
  textoHash             String
  otorgadaEn            DateTime  @default(now())
  expiraEn              DateTime
  /// Trazas de la aceptación (prueba de la autorización, Ley 1581 art. 9).
  ip                    String    @default("")
  userAgent             String    @default("")
  /// en_curso | exitosa | fallida | revocada
  resultado             String    @default("en_curso")
  motivoFallo           String    @default("")
  finalizadaEn          DateTime?
  revocadaEn            DateTime?

  @@index([operadorUsuarioId, otorgadaEn])
  @@index([titularIdentificacion, otorgadaEn])
}

/// Persona administrada (tercero cuyas declaraciones elabora el usuario)
model Persona {
  id             String   @id @default(uuid())
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombres        String
  apellidos      String
  identificacion String
  email          String   @default("")
  telefono       String   @default("")
  creadaEn       DateTime @default(now())

  @@unique([usuarioId, identificacion])
}

/// Registro de eventos reales del usuario (para "Actividad reciente")
model Actividad {
  id            String   @id @default(uuid())
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo          String
  descripcion   String
  declaracionId String   @default("")
  creadaEn      DateTime @default(now())

  @@index([usuarioId, creadaEn])
}

/// Notificación in-app; claveIdempotencia evita duplicados al re-evaluar reglas
model Notificacion {
  id                String    @id @default(uuid())
  usuarioId         String
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo              String
  titulo            String
  cuerpo            String
  claveIdempotencia String    @unique
  emailEnviado      Boolean   @default(false)
  leidaEn           DateTime?
  creadaEn          DateTime  @default(now())

  @@index([usuarioId, creadaEn])
}

model CodigoOtp {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String
  expiraEn   DateTime
  usadoEn    DateTime?
  creadoEn   DateTime  @default(now())

  @@index([usuarioId, expiraEn])
}

model Declaracion {
  id                    String   @id @default(uuid())
  usuarioId             String
  usuario               Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  anioGravable          Int
  /// Titular de la declaración (el propio usuario o un tercero)
  titularNombres        String   @default("")
  titularApellidos      String   @default("")
  titularIdentificacion String   @default("")
  esPropia              Boolean  @default(true)
  /// Estado completo del wizard (documentos extraídos, respuestas, declarante, resultado)
  estado                Json
  creadaEn              DateTime @default(now())
  actualizadaEn         DateTime @updatedAt

  @@unique([usuarioId, titularIdentificacion, anioGravable])
  @@index([usuarioId, actualizadaEn])
}
